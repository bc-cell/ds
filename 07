library(tidyverse)
library(countrycode)
library(lubridate)

refugees_raw <- read_csv("C:/Users/user/Downloads/refugee_status.csv", na = c("-", "X", "D"))

non_countries <- c("Africa", "Asia", "Europe", "North America", "Oceania",
                   "South America", "Unknown", "Other", "Total")

refugees_clean <- refugees_raw %>%
  rename(origin_country = `Continent/Country of Nationality`) %>%
  filter(!(origin_country %in% non_countries)) %>%
  mutate(iso3 = countrycode(origin_country, "country.name", "iso3c",
                            custom_match = c("Korea, North" = "PRK"))) %>%
  mutate(origin_country = countrycode(iso3, "iso3c", "country.name"),
         origin_region = countrycode(iso3, "iso3c", "region"),
         origin_continent = countrycode(iso3, "iso3c", "continent")) %>%
  gather(year, number, -origin_country, -iso3, -origin_region, -origin_continent) %>%
  mutate(year = as.numeric(year),
         year_date = ymd(paste0(year, "-01-01")))

refugees_specific <- refugees_clean %>%
  filter(origin_country %in% c("Iran", "Iraq", "Syria"))

p1 <- ggplot(refugees_specific, aes(x = year_date, y = number, color = origin_country)) +
  geom_line(linewidth = 0.8) +
  labs(title = "1. Specific countries over time",
       x = "year_date", y = "number", color = "origin_country") +
  theme_minimal() +
  theme(legend.position = "bottom")

print(p1)

refugees_countries_cumulative <- refugees_specific %>%
  arrange(year_date) %>%
  group_by(origin_country) %>%
  mutate(number = replace_na(number, 0),
         cumulative_total = cumsum(number))

p2 <- ggplot(refugees_countries_cumulative, aes(x = year_date, y = cumulative_total, color = origin_country)) +
  geom_line(linewidth = 0.8) +
  labs(title = "2. Specific countries over time, cumulative",
       x = "year_date", y = "cumulative_total", color = "origin_country") +
  theme_minimal() +
  theme(legend.position = "bottom")

print(p2)

refugees_continents <- refugees_clean %>%
  group_by(origin_continent, year_date) %>%
  summarize(total = sum(number, na.rm = TRUE), .groups = "drop")

p3 <- ggplot(refugees_continents, aes(x = year_date, y = total, color = origin_continent)) +
  geom_line(linewidth = 0.8) +
  labs(title = "3. Continents over time",
       x = "year_date", y = "total", color = "origin_continent") +
  theme_minimal() +
  theme(legend.position = "bottom")

print(p3)

refugees_continents_cumulative <- refugees_continents %>%
  arrange(year_date) %>%
  group_by(origin_continent) %>%
  mutate(cumulative_total = cumsum(total))

p4 <- ggplot(refugees_continents_cumulative, aes(x = year_date, y = cumulative_total, color = origin_continent)) +
  geom_line(linewidth = 0.8) +
  labs(title = "4. Continents over time, cumulative",
       x = "year_date", y = "cumulative_total", color = "origin_continent") +
  theme_minimal() +
  theme(legend.position = "bottom")

print(p4)

library(maps)

refugees_2015 <- refugees_clean %>%
  filter(year == 2015)

world_map <- map_data("world") %>%
  filter(region != "Antarctica") %>%
  mutate(iso3 = countrycode(region, "country.name", "iso3c",
                            custom_match = c("UK" = "GBR", "USA" = "USA")))

map_data_2015 <- left_join(world_map, refugees_2015, by = "iso3")

p5 <- ggplot(map_data_2015, aes(x = long, y = lat, group = group, fill = number)) +
  geom_polygon(color = "black", linewidth = 0.15) +
  scale_fill_viridis_c(na.value = "white", name = "number") +
  labs(title = "Refugees admitted to the US in 2015") +
  theme_void() +
  theme(legend.position = "right")

print(p5)
