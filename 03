library(dplyr)
library(ggplot2)
library(caret)
library(datarium)

data("marketing", package = "datarium")

head(marketing)

dim(marketing)

summary(marketing)

str(marketing)

sum(!complete.cases(marketing))

ggplot(marketing, aes(x = sales)) +
  geom_histogram(binwidth = 5, fill = "skyblue",
                 color = "black") +
  labs(title = "Histogram of Sales", y = "Count") +
  theme_classic()

ggplot(marketing, aes(x = youtube, y = sales)) +
  geom_point() +
  stat_smooth(method = "loess") +
  labs(title = "YouTube Advertising vs Sales",
       x = "YouTube Advertising Budget",
       y = "Sales") +
  theme_classic()

cor(marketing$sales, marketing$youtube)

set.seed(123)

training.samples <- createDataPartition(
  marketing$sales, p = 0.8, list = FALSE
)

train.data <- marketing[training.samples, ]
test.data <- marketing[-training.samples, ]

model <- lm(sales ~ youtube, data = train.data)

summary(model)$coef

predictions <- predict(model, newdata = test.data)


RMSE(predictions, test.data$sales)


R2(predictions, test.data$sales)

newdata <- data.frame(youtube = c(0, 1000))

predictions <- predict(model, newdata = newdata)

print(predictions)
